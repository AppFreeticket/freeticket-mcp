          }
        },
        "required": [
          "slug",
          "dates"
        ],
        "additionalProperties": false
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "buyerEmail": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "buyerName": {
            "type": "string",
            "minLength": 1
          },
          "buyerPhone": {
            "type": "string"
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ticketTypeId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 50
                }
              },
              "required": [
                "ticketTypeId",
                "quantity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "buyerEmail",
          "buyerName",
          "items"
        ],
        "additionalProperties": false
      },
      "OrderCreated": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "expired",
              "cancelled"
            ]
          },
          "total": {
            "type": "number"
          },
          "currency": {
            "type": "string"
