{
	"openapi": "3.1.0",
	"info": {
		"title": "FreeTicket Public API",
		"version": "0.9.1",
		"description": "FreeTicket public REST API for B2C buyers and their agents (CLI/MCP). Anonymous and strictly rate-limited: no endpoint requires an API key. The only exception is `POST /orders` with `items[].seats` (numbered seats), which requires a buyer session — the `ft-customer` cookie or the `X-Customer-Session` header. Isolated from the B2B /api/v1 and superadmin /api/admin contracts."
	},
	"servers": [
		{
			"url": "https://admin.appfreeticket.com/api/public"
		}
	],
	"security": [
		{
			"customerSession": []
		}
	],
	"paths": {
		"/events/{slug}": {
			"get": {
				"operationId": "getEventsSlug",
				"tags": ["catalog"],
				"summary": "Get a public event by slug",
				"description": "Public (no auth). Detail of a PUBLISHED event: description, dates (with venue and city) and the 'from' price in two flavors: `priceFrom` (base, no fees) and `buyerTotalFrom` (including service fee, VAT (IVA), seat surcharge and any products bundled with that ticket, e.g. a drink combo). For live stock per ticket type, use `/events/{slug}/availability`.",
				"security": [],
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"$ref": "#/components/schemas/PublicEventDetail"
										}
									},
									"required": ["data"]
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid credential.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "Insufficient role or resource not accessible.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "Resource does not exist or is out of scope.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "Request body/parameter validation failed.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
