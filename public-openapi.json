		"securitySchemes": {
			"customerSession": {
				"type": "apiKey",
				"in": "header",
				"name": "X-Customer-Session",
				"description": "B2C buyer session. Obtained via POST /api/v1/customer/auth/request (code sent by email) + POST /api/v1/customer/auth/verify, which returns `session_token`. A browser can present the `ft-customer` cookie instead. Only orders with numbered seats require it (`POST /orders` with `items[].seats`); the rest of the contract is anonymous."
			}
		}
