		"/events": {
			"get": {
				"operationId": "getEvents",
				"tags": ["catalog"],
				"summary": "Public event catalog (B2C discovery)",
				"description": "Public (no auth). Lists PUBLISHED events with at least one upcoming date. Filters: `q` (text), `city`, `from`/`to` (ISO 8601), `page`, `pageSize` (≤50), `sort` (date_asc | price_asc | price_desc). Returns a summary with the next date and two 'from' prices: `priceFrom` (base, no fees) and `buyerTotalFrom` (what the buyer pays for one unit of that same ticket type, including service fee, VAT (IVA) and seat surcharge). Cache-friendly, no personal data.",
				"security": [],
				"parameters": [
					{
						"name": "q",
						"in": "query",
						"required": false,
						"description": "Search by name/description",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "city",
						"in": "query",
						"required": false,
						"description": "Filter by venue city",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "from",
						"in": "query",
						"required": false,
						"description": "Dates from (ISO 8601)",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "to",
						"in": "query",
						"required": false,
						"description": "Dates until (ISO 8601)",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "page",
						"in": "query",
						"required": false,
						"description": "Page (default 1)",
						"schema": {
							"type": "integer",
							"default": 1
						}
					},
					{
						"name": "pageSize",
						"in": "query",
						"required": false,
						"description": "Page size (default 20, max 50)",
						"schema": {
							"type": "integer",
							"default": 20
						}
					},
					{
						"name": "sort",
						"in": "query",
						"required": false,
						"description": "date_asc | price_asc | price_desc",
						"schema": {
							"type": "string",
							"enum": ["date_asc", "price_asc", "price_desc"]
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"type": "array",
											"items": {
												"$ref": "#/components/schemas/PublicEventSummary"
											}
										}
									},
									"required": ["data"]
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid credential.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "Insufficient role or resource not accessible.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "Resource does not exist or is out of scope.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "Request body/parameter validation failed.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/events/{slug}/availability": {
			"get": {
				"operationId": "getEventsSlugAvailability",
				"tags": ["catalog"],
				"summary": "Live availability by date and ticket type",
				"description": "Public (no auth). Live stock (capacity - sold - reserved) per date and ticket type, upcoming dates only. Each type includes the base price (`price`) and the final per-unit price (`buyerTotal` = price + service fee + VAT (IVA) + numbered-seat surcharge): quote the buyer with `buyerTotal`, not `price`. For NUMBERED ticket types (`seatsioCategoryKey` not null), `availableSeats` lists the exact label of every seat free right now — those labels are what goes into `items[].seats` in POST /orders. Check this before creating an order. Do not cache aggressively: stock (and seats) change.",
				"security": [],
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"$ref": "#/components/schemas/PublicAvailability"
										}
									},
									"required": ["data"]
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid credential.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "Insufficient role or resource not accessible.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "Resource does not exist or is out of scope.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "Request body/parameter validation failed.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/orders": {
			"post": {
				"operationId": "postOrders",
				"tags": ["orders"],
				"summary": "Create a B2C order and get the payment link (Mercado Pago)",
				"description": "Public for general admission (no auth, strict per-IP rate limit); orders with numbered seats REQUIRE a buyer session. Creates a PENDING sale + stock reservation and returns the Mercado Pago `checkoutUrl` to send the buyer to. The reservation holds the inventory for the payment window configured for that date (30 minutes unless the organizer sets it shorter or longer; never less than 10). The response includes `expiresAt`: the EXACT instant (ISO 8601, UTC) at which that reservation expires, the same one stored server-side. This is the value that decides whether it still makes sense to send the buyer to pay: past that instant the inventory has already returned to stock —and, for numbered seating, the seat is already on someone else's map— so the `checkoutUrl` may still open and the payment may arrive late. Do not recompute it by adding minutes on the client: use the returned value. `GET /orders/{id}` repeats it while the order is still `pending` (and returns null once it no longer is), so a countdown can resume after a reload instead of restarting. The agent NEVER processes the payment. Not available for members-only tickets (members_only); PUBLISHED events with sales open, all from a single organizer. Inventory is protected by a Serializable transaction. NUMBERED ticket types (seats.io): `items[].seats` is required, with one EXACT label per unit (taken from `availableSeats` in GET /events/{slug}/availability) — the seat is held in seats.io with the same TTL as the stock reservation, and is released automatically if the order expires unpaid. An order with `items[].seats` additionally requires a BUYER SESSION: the `ft-customer` cookie or the `session_token` from the code login (POST /api/v1/customer/auth/request + POST /api/v1/customer/auth/verify) in the `X-Customer-Session` header; without it the response is 401 `CUSTOMER_SESSION_REQUIRED`. A seats.io hold can only be released by the sale that took it, so a seat held anonymously is inventory nobody can reclaim. The order is linked to that account: it shows up in GET /api/v1/customer/orders and its tickets in /api/v1/customer/tickets. General admission (no `seats`) remains anonymous and is not linked to any account. Dates with an active virtual queue: 409 `QUEUE_REQUIRED` (with `details.waitingRoomUrl`) — the waiting room is the only way in; the gate runs BEFORE the seats.io retrieve/hold. Check the status with `GET /orders/{id}`.\n\n409 errors (`error.code`): `MEMBERS_ONLY` (members-only ticket), `NOT_AVAILABLE` (event or date not published, or date already past), `EXTERNAL_SALE` (the event sells elsewhere), `SALE_CLOSED` (outside the sales window), `QUEUE_REQUIRED` (the date is sold through a waiting room: `details.waitingRoomUrl` is the ABSOLUTE URL to send the buyer to — it points to the host where THAT date is sold, which may be the portal (`/eventos/{slug}/fila`) or the organizer's or artist's own subdomain (`/events/{slug}/fila`); use it as-is, do not rebuild it), `MULTIPLE_ORGS` (tickets from multiple organizers), `MIXED_CURRENCY` (mixed currencies), `SEAT_NOT_AVAILABLE` (seat already sold or held), `ADDON_SOLD_OUT` (a product bundled with the ticket, e.g. a drink combo, sold out: the order is not created). Products bundled with a ticket travel with it automatically —they are not requested in `items`— and their price is already included in `total`.",
				"security": [
					{},
					{
						"customerSession": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateOrderRequest"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"$ref": "#/components/schemas/OrderCreated"
										}
									},
									"required": ["data"]
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid credential.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "Insufficient role or resource not accessible.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "Resource does not exist or is out of scope.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "Conflict: the resource does not allow this operation in its current state.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "Operation error.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"429": {
						"description": "Too many requests: rate limit exceeded.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"502": {
						"description": "The external provider failed to complete the operation.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/orders/{id}": {
			"get": {
				"operationId": "getOrdersId",
				"tags": ["orders"],
				"summary": "Get a B2C order's status (and tickets once paid)",
				"description": "Public (no auth). Order status: `pending | paid | expired | cancelled`. Once paid (`paid`) it includes the issued ticket codes; the QR/ticket is delivered by email. While still `pending` it returns `expiresAt`, the instant (ISO 8601, UTC) at which its reservation expires — the SAME one returned by `POST /orders`, so a countdown can resume after a reload instead of restarting. It may be in the PAST: that means the reservation has already expired and there is no point sending the buyer to pay, even if the `checkoutUrl` still opens. A null `expiresAt` NEVER means 'no time limit': it means the order is no longer pending, or there is no reservation. The id is a non-enumerable cuid; no buyer data is exposed.",
				"security": [],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"$ref": "#/components/schemas/OrderStatus"
										}
									},
									"required": ["data"]
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid credential.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "Insufficient role or resource not accessible.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "Resource does not exist or is out of scope.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"422": {
						"description": "Request body/parameter validation failed.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"Error": {
				"type": "object",
				"properties": {
					"error": {
						"type": "object",
						"properties": {
							"code": {
								"type": "string"
							},
							"message": {
								"type": "string"
							},
							"retryable": {
								"type": "boolean"
							},
							"details": {}
						},
						"required": ["code", "message", "retryable"],
						"additionalProperties": false
					}
				},
				"required": ["error"],
				"additionalProperties": false
			},
			"ResendTicketRequest": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string",
						"format": "email",
						"pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
					}
				},
				"additionalProperties": false
			},
			"ResendTicketResult": {
				"type": "object",
				"properties": {
					"sent": {
						"type": "boolean",
						"const": true
					},
					"maskedEmail": {
						"type": "string"
					}
				},
				"required": ["sent", "maskedEmail"],
				"additionalProperties": false
			},
			"PublicEventSummary": {
				"type": "object",
				"properties": {
					"slug": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"description": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						]
					},
					"coverImageUrl": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						]
					},
					"city": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						]
					},
					"nextDate": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						]
					},
					"priceFrom": {
						"anyOf": [
							{
								"type": "number"
							},
							{
								"type": "null"
							}
						],
						"description": "Cheapest BASE price, excluding service fee, VAT (IVA) and the numbered-seat surcharge. To quote what the buyer actually pays, use buyerTotalFrom."
					},
					"buyerTotalFrom": {
						"anyOf": [
							{
								"type": "number"
							},
							{
								"type": "null"
							}
						],
						"description": "Final per-unit price of the ticket type with the cheapest base price (includes service fee, VAT (IVA) and the numbered-seat surcharge). The authoritative order total is computed by POST /orders."
					},
					"currency": {
						"type": "string"
					}
				},
				"required": [
					"slug",
					"name",
					"description",
					"coverImageUrl",
					"city",
					"nextDate",
					"priceFrom",
					"buyerTotalFrom",
					"currency"
				],
				"additionalProperties": false
			},
			"PublicAvailableSeat": {
				"type": "object",
				"properties": {
					"label": {
						"type": "string",
						"description": "EXACT seat label in seats.io."
					},
					"categoryKey": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						]
					},
					"categoryLabel": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						]
					},
					"status": {
						"type": "string",
						"const": "free"
					}
				},
